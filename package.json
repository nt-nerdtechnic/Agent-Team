{
  "name": "agent-team",
  "version": "0.1.93",
  "private": true,
  "author": "Navide Team",
  "description": "Navide: the AI-native engineering environment for one engineer directing multiple coding agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/nt-nerdtechnic/Navide.git"
  },
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm run build:official-plugins && pnpm run build:git:legacy && electron-vite build",
    "build:official-plugins": "pnpm run build:mini-ide && pnpm run build:plans && pnpm run build:git:v2",
    "build:mini-ide": "vite build --config vite.mini-ide.config.ts",
    "build:plans": "vite build --config vite.plans.config.ts",
    "build:git:legacy": "vite build --config vite.git.config.ts",
    "build:git:v2": "vite build --config plugins/navide-git/vite.config.ts",
    "build:git": "pnpm run build:git:legacy && pnpm run build:git:v2",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck:public": "tsc --noEmit -p packages/plugin-contracts/tsconfig.json && tsc --noEmit -p packages/plugin-sdk/tsconfig.json && vue-tsc --noEmit -p packages/plugin-ui/tsconfig.json",
    "typecheck:plugin-git": "vue-tsc --noEmit -p plugins/navide-git/tsconfig.json",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:plugin-git && pnpm run typecheck:web && pnpm run typecheck:public",
    "build:public-packages": "tsc -p packages/plugin-contracts/tsconfig.json && tsc -p packages/plugin-sdk/tsconfig.build.json && vite build --config packages/plugin-ui/vite.config.ts && vue-tsc -p packages/plugin-ui/tsconfig.build.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "backend:dev": "uv --project backend run python -m agent_team_backend",
    "package:local": "bash ./build.sh",
    "dist": "pnpm build && electron-builder",
    "release:check": "node scripts/verify-release-version.mjs",
    "release:prepare": "bash ./release.sh"
  },
  "build": {
    "appId": "com.nerdtechnic.agent-team",
    "productName": "Navide",
    "directories": {
      "output": "dist-release"
    },
    "files": [
      "out/**/*",
      "!node_modules/{monaco-editor,mermaid,@xterm}/**"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/"
      },
      {
        "from": "backend/dist/agent_team_backend",
        "to": "bin/agent_team_backend"
      },
      {
        "from": "dist-plugins/mini-ide",
        "to": "plugins/mini-ide"
      },
      {
        "from": "dist-plugins/plans",
        "to": "plugins/plans"
      },
      {
        "from": "dist-plugins/navide-git",
        "to": "plugins/navide-git"
      },
      {
        "from": "dist-plugins/git",
        "to": "plugins/git"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "nt-nerdtechnic",
        "repo": "Navide",
        "releaseType": "release"
      }
    ],
    "artifactName": "Navide-${version}-${arch}.${ext}",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.icns",
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true,
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Folder",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.folder"
            ]
          }
        ]
      }
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "resources/icon.png"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.10",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.0",
    "electron-vite": "^2.3.0",
    "happy-dom": "^15.11.7",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vitest": "^2.1.9",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "koffi": "^3.1.0",
    "mermaid": "^11.15.0",
    "monaco-editor": "^0.55.1",
    "vue-i18n": "11",
    "ws": "^8.21.1",
    "yaml": "^2.9.0"
  }
}
