{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@navide/plugin-sdk": ["packages/plugin-sdk/src/index.ts"],
      "@navide/plugin-contracts": ["packages/plugin-contracts/src/index.ts"],
      "@navide/git-feature": ["plugins/navide-git/src/git-feature/index.ts"],
      "@navide/git-feature/testing": ["plugins/navide-git/src/git-feature/testing.ts"],
      "@navide/shared": ["packages/plugin-ui-vue/src/shared/index.ts"],
      "@navide/shared/testing": ["packages/plugin-ui-vue/src/shared/testing.ts"],
      "@navide/terminal": ["src/renderer/src/platform/terminal/index.ts"],
      "@navide/terminal/testing": ["src/renderer/src/platform/terminal/testing.ts"],
      "@navide/plugin-shell": ["src/renderer/src/platform/plugin-shell/index.ts"],
      "@navide/ui-foundation": ["packages/plugin-ui-vue/src/foundation/index.ts"],
      "@navide/ui-foundation/*": ["packages/plugin-ui-vue/src/foundation/*"]
    }
  },
  "include": [
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.vue",
    "src/renderer/src/**/*.d.ts",
    "src/renderer/plugins/**/*.ts",
    "src/shared/**/*.ts",
    "packages/plugin-contracts/src/**/*.ts",
    "packages/plugin-sdk/src/**/*.ts",
    "plugins/navide-git/src/git-feature/**/*.ts",
    "packages/plugin-ui-vue/src/**/*.ts",
    "packages/plugin-ui-vue/src/**/*.vue"
  ]
}
