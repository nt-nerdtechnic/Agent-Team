{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@navide/shared": ["packages/features/shared/src/index.ts"],
      "@navide/shared/testing": ["packages/features/shared/src/testing.ts"],
      "@navide/ui-foundation": ["packages/features/ui-foundation/src/index.ts"],
      "@navide/terminal": ["packages/features/terminal/src/index.ts"],
      "@navide/terminal/testing": ["packages/features/terminal/src/testing.ts"],
      "@navide/plugin-shell": ["packages/features/plugin-shell/src/index.ts"],
      "@navide/git-feature": ["packages/features/git/src/index.ts"]
    }
  },
  "include": [
    "packages/features/git/src/**/*.ts",
    "packages/features/shared/src/**/*.ts",
    "packages/features/shared/src/**/*.vue",
    "packages/features/ui-foundation/src/**/*.ts",
    "packages/features/ui-foundation/src/**/*.vue",
    "packages/features/terminal/src/**/*.ts",
    "packages/features/terminal/src/**/*.vue",
    "packages/features/plugin-shell/src/**/*.ts",
    "packages/features/plugin-shell/src/**/*.vue",
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.vue",
    "src/renderer/src/**/*.d.ts",
    "src/renderer/plugins/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
