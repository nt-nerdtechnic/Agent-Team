{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@navide/git-feature": ["plugins/navide-git/src/git-feature/index.ts"]
    }
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "packages/plugin-contracts/src/**/*.ts",
    "plugins/navide-git/src/git-feature/**/*.ts",
    "electron.vite.config.ts"
  ]
}
