{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "catalogVersion": 1,
  "status": "draft",
  "runtimeStatus": "host-enforced-by-issue-03-with-issue-16-storage-seam",
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": ["string", "number", "boolean", "null"] },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    }
  },
  "manifestPermissionContract": {
    "shape": "system-namespace-array-plus-shell-mode",
    "scopeSource": "catalog",
    "duplicateObjectKeys": "reject-before-schema-validation",
    "unknownPermissionOrAccess": "reject"
  },
  "hostShellExecutableAllowlist": ["git", "gh", "glab"],
  "errors": [
    "CAPABILITY_DENIED",
    "METHOD_NOT_FOUND",
    "INVALID_ARGUMENT",
    "WORKSPACE_SCOPE_VIOLATION",
    "USER_CANCELLED",
    "TIMEOUT",
    "BACKEND_UNAVAILABLE",
    "PLUGIN_STOPPING",
    "STORAGE_QUOTA_EXCEEDED",
    "INTERNAL_ERROR"
  ],
  "methods": [
    {
      "address": "fs.readFile",
      "visibility": "public",
      "permission": { "id": "system", "access": "fs", "scope": "workspace" },
      "params": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string" } } },
      "result": { "type": "object", "additionalProperties": false, "required": ["content"], "properties": { "content": { "type": "string" } } },
      "errors": ["CAPABILITY_DENIED", "INVALID_ARGUMENT", "WORKSPACE_SCOPE_VIOLATION", "BACKEND_UNAVAILABLE", "INTERNAL_ERROR"]
    },
    {
      "address": "fs.listDirectory",
      "visibility": "public",
      "permission": { "id": "system", "access": "fs", "scope": "workspace" },
      "params": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string" } } },
      "result": { "type": "object", "additionalProperties": false, "required": ["entries"], "properties": { "entries": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "kind"], "properties": { "name": { "type": "string" }, "kind": { "enum": ["file", "directory"] } } } } } },
      "errors": ["CAPABILITY_DENIED", "INVALID_ARGUMENT", "WORKSPACE_SCOPE_VIOLATION", "BACKEND_UNAVAILABLE", "INTERNAL_ERROR"]
    },
    {
      "address": "fs.writeFile",
      "visibility": "public",
      "permission": { "id": "system", "access": "fs", "scope": "workspace" },
      "params": { "type": "object", "additionalProperties": false, "required": ["path", "content"], "properties": { "path": { "type": "string" }, "content": { "type": "string" } } },
      "result": { "type": "object", "additionalProperties": false, "required": ["ok"], "properties": { "ok": { "type": "boolean" } } },
      "errors": ["CAPABILITY_DENIED", "INVALID_ARGUMENT", "WORKSPACE_SCOPE_VIOLATION", "BACKEND_UNAVAILABLE", "INTERNAL_ERROR"]
    },
    {
      "address": "fs.readImage",
      "visibility": "public",
      "permission": { "id": "system", "access": "fs", "scope": "workspace" },
      "params": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string" } } },
      "result": { "type": "object", "additionalProperties": false, "required": ["ok"], "properties": { "ok": { "type": "boolean" }, "data_url": { "type": "string" } } },
      "errors": ["CAPABILITY_DENIED", "INVALID_ARGUMENT", "WORKSPACE_SCOPE_VIOLATION", "BACKEND_UNAVAILABLE", "INTERNAL_ERROR"]
    },
    {
      "address": "fs.listFilesFlat",
      "visibility": "public",
      "permission": { "id": "system", "access": "fs", "scope": "workspace" },
      "params": { "type": "object", "additionalProperties": false, "properties": { "query": { "type": "string" }, "maxResults": { "type": "integer", "minimum": 1 } } },
      "result": { "type": "object", "additionalProperties": false, "properties": { "files": { "type": "array", "items": { "type": "string" } } } },
      "errors": ["CAPABILITY_DENIED", "INVALID_ARGUMENT", "WORKSPACE_SCOPE_VIOLATION", "BACKEND_UNAVAILABLE", "INTERNAL_ERROR"]
    },
    {
      "address": "fs.glob",
      "visibility": "public",
      "permission": { "id": "system", "access": "fs", "scope": "workspace" },
      "params": { "type": "object", "additionalProperties": false, "required": ["pattern"], "properties": { "pattern": { "type": "string" } } },
      "result": { "type": "object", "additionalProperties": false, "required": ["paths"], "properties": { "paths": { "type": "array", "items": { "type": "string" } } } },
      "errors": ["CAPABILITY_DENIED", "INVALID_ARGUMENT", "WORKSPACE_SCOPE_VIOLATION", "BACKEND_UNAVAILABLE", "INTERNAL_ERROR"]
    },
    {
      "address": "fs.stat",
      "visibility": "public",
      "permission": { "id": "system", "access": "fs", "scope": "workspace" },
      "params": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string" } } },
      "result": { "type": "object", "additionalProperties": false, "required": ["kind", "size", "modifiedAt"], "properties": { "kind": { "enum": ["file", "directory"] }, "size": { "type": "integer", "minimum": 0 }, "modifiedAt": { "type": "string", "format": "date-time" } } },
      "errors": ["CAPABILITY_DENIED", "INVALID_ARGUMENT", "WORKSPACE_SCOPE_VIOLATION", "BACKEND_UNAVAILABLE", "INTERNAL_ERROR"]
    },
    {
      "address": "fs.statPath",
      "visibility": "public",
      "permission": { "id": "system", "access": "fs", "scope": "workspace" },
      "params": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string" } } },
      "result": { "type": "object", "additionalProperties": false, "required": ["exists"], "properties": { "exists": { "type": "boolean" } } },
      "errors": ["CAPABILITY_DENIED", "INVALID_ARGUMENT", "WORKSPACE_SCOPE_VIOLATION", "BACKEND_UNAVAILABLE", "INTERNAL_ERROR"]
    },
    {
      "address": "ui.openInEditor",
      "visibility": "public",
      "permission": { "id": "system", "access": "ui", "scope": "workspace" },
      "params": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string" }, "line": { "type": "integer", "minimum": 1 }, "column": { "type": "integer", "minimum": 1 } } },
      "result": { "type": "object", "additionalProperties": false, "required": ["opened"], "properties": { "opened": { "type": "boolean" } } },
      "errors": ["CAPABILITY_DENIED", "INVALID_ARGUMENT", "WORKSPACE_SCOPE_VIOLATION", "INTERNAL_ERROR"]
    },
    {
      "address": "ui.openExternal",
      "visibility": "public",
      "permission": { "id": "system", "access": "ui", "scope": "plugin" },
      "requiresUserGesture": true,
      "params": { "type": "object", "additionalProperties": false, "required": ["url"], "properties": { "url": { "type": "string", "format": "uri", "pattern": "^https://" } } },
      "result": { "type": "object", "additionalProperties": false, "required": ["opened"], "properties": { "opened": { "type": "boolean" } } },
      "errors": ["CAPABILITY_DENIED", "INVALID_ARGUMENT", "USER_CANCELLED", "INTERNAL_ERROR"]
    },
    {
      "address": "aiCli.listProfiles",
      "visibility": "public",
      "permission": { "id": "system", "access": "aiCli", "scope": "workspace" },
      "params": { "type": "object", "additionalProperties": false },
      "result": { "type": "object", "additionalProperties": false, "required": ["profiles"], "properties": { "profiles": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "label"], "properties": { "id": { "type": "string", "minLength": 1 }, "label": { "type": "string", "minLength": 1 } } } } } },
      "errors": ["CAPABILITY_DENIED", "WORKSPACE_SCOPE_VIOLATION", "BACKEND_UNAVAILABLE", "INTERNAL_ERROR"]
    },
    {
      "address": "aiCli.startSession",
      "visibility": "public",
      "permission": { "id": "system", "access": "aiCli", "scope": "workspace" },
      "params": { "type": "object", "additionalProperties": false, "required": ["profileId", "cols", "rows"], "properties": { "profileId": { "type": "string", "minLength": 1 }, "requestId": { "type": "string", "minLength": 1 }, "cols": { "type": "integer", "minimum": 1 }, "rows": { "type": "integer", "minimum": 1 }, "yolo": { "type": "boolean" } } },
      "result": { "type": "object", "additionalProperties": false, "required": ["sessionId"], "properties": { "sessionId": { "type": "string", "minLength": 1 } } },
      "errors": ["CAPABILITY_DENIED", "INVALID_ARGUMENT", "WORKSPACE_SCOPE_VIOLATION", "USER_CANCELLED", "BACKEND_UNAVAILABLE", "INTERNAL_ERROR"]
    },
    {
      "address": "aiCli.resumeSession",
      "visibility": "public",
      "permission": { "id": "system", "access": "aiCli", "scope": "workspace" },
      "params": { "type": "object", "additionalProperties": false, "required": ["cols", "rows"], "properties": { "cols": { "type": "integer", "minimum": 1 }, "rows": { "type": "integer", "minimum": 1 } } },
      "result": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["sessionId", "profileId"], "properties": { "sessionId": { "type": "string", "minLength": 1 }, "profileId": { "type": "string", "minLength": 1 } } }] },
      "errors": ["CAPABILITY_DENIED", "INVALID_ARGUMENT", "WORKSPACE_SCOPE_VIOLATION", "BACKEND_UNAVAILABLE", "INTERNAL_ERROR"]
    },
    {
      "address": "aiCli.cancelStart",
      "visibility": "public",
      "permission": { "id": "system", "access": "aiCli", "scope": "workspace" },
      "params": { "type": "object", "additionalProperties": false, "required": ["requestId"], "properties": { "requestId": { "type": "string", "minLength": 1 } } },
      "result": { "type": "object", "additionalProperties": false },
      "errors": ["CAPABILITY_DENIED", "INVALID_ARGUMENT", "WORKSPACE_SCOPE_VIOLATION", "USER_CANCELLED", "BACKEND_UNAVAILABLE", "INTERNAL_ERROR"]
    },
    {
      "address": "aiCli.reattachSession",
      "visibility": "public",
      "permission": { "id": "system", "access": "aiCli", "scope": "workspace" },
      "params": { "type": "object", "additionalProperties": false, "required": ["sessionId"], "properties": { "sessionId": { "type": "string", "minLength": 1 } } },
      "result": { "type": "object", "additionalProperties": false, "required": ["sessionId"], "properties": { "sessionId": { "type": "string", "minLength": 1 } } },
      "errors": ["CAPABILITY_DENIED", "INVALID_ARGUMENT", "WORKSPACE_SCOPE_VIOLATION", "BACKEND_UNAVAILABLE", "INTERNAL_ERROR"]
    },
    {
      "address": "aiCli.sendInput",
      "visibility": "public",
      "permission": { "id": "system", "access": "aiCli", "scope": "workspace" },
      "params": { "type": "object", "additionalProperties": false, "required": ["sessionId", "data"], "properties": { "sessionId": { "type": "string", "minLength": 1 }, "data": { "type": "string" } } },
      "result": { "type": "object", "additionalProperties": false },
      "errors": ["CAPABILITY_DENIED", "INVALID_ARGUMENT", "WORKSPACE_SCOPE_VIOLATION", "BACKEND_UNAVAILABLE", "INTERNAL_ERROR"]
    },
    {
      "address": "aiCli.resizeSession",
      "visibility": "public",
      "permission": { "id": "system", "access": "aiCli", "scope": "workspace" },
      "params": { "type": "object", "additionalProperties": false, "required": ["sessionId", "cols", "rows"], "properties": { "sessionId": { "type": "string", "minLength": 1 }, "cols": { "type": "integer", "minimum": 1 }, "rows": { "type": "integer", "minimum": 1 } } },
      "result": { "type": "object", "additionalProperties": false },
      "errors": ["CAPABILITY_DENIED", "INVALID_ARGUMENT", "WORKSPACE_SCOPE_VIOLATION", "BACKEND_UNAVAILABLE", "INTERNAL_ERROR"]
    },
    {
      "address": "aiCli.redrawSession",
      "visibility": "public",
      "permission": { "id": "system", "access": "aiCli", "scope": "workspace" },
      "params": { "type": "object", "additionalProperties": false, "required": ["sessionId"], "properties": { "sessionId": { "type": "string", "minLength": 1 } } },
      "result": { "type": "object", "additionalProperties": false },
      "errors": ["CAPABILITY_DENIED", "INVALID_ARGUMENT", "WORKSPACE_SCOPE_VIOLATION", "BACKEND_UNAVAILABLE", "INTERNAL_ERROR"]
    },
    {
      "address": "aiCli.interruptSession",
      "visibility": "public",
      "permission": { "id": "system", "access": "aiCli", "scope": "workspace" },
      "params": { "type": "object", "additionalProperties": false, "required": ["sessionId"], "properties": { "sessionId": { "type": "string", "minLength": 1 } } },
      "result": { "type": "object", "additionalProperties": false },
      "errors": ["CAPABILITY_DENIED", "INVALID_ARGUMENT", "WORKSPACE_SCOPE_VIOLATION", "BACKEND_UNAVAILABLE", "INTERNAL_ERROR"]
    },
    {
      "address": "aiCli.stopSession",
      "visibility": "public",
      "permission": { "id": "system", "access": "aiCli", "scope": "workspace" },
      "params": { "type": "object", "additionalProperties": false, "required": ["sessionId"], "properties": { "sessionId": { "type": "string", "minLength": 1 } } },
      "result": { "type": "object", "additionalProperties": false },
      "errors": ["CAPABILITY_DENIED", "INVALID_ARGUMENT", "WORKSPACE_SCOPE_VIOLATION", "BACKEND_UNAVAILABLE", "INTERNAL_ERROR"]
    },
    {
      "address": "shell.run",
      "visibility": "public",
      "permission": { "id": "shell", "scope": "workspace" },
      "params": { "type": "object", "additionalProperties": false, "required": ["command"], "properties": { "command": { "type": "string", "minLength": 1 } } },
      "result": { "type": "object", "additionalProperties": false, "required": ["exitCode", "stdout", "stderr"], "properties": { "exitCode": { "type": "integer" }, "stdout": { "type": "string" }, "stderr": { "type": "string" } } },
      "errors": ["CAPABILITY_DENIED", "INVALID_ARGUMENT", "WORKSPACE_SCOPE_VIOLATION", "USER_CANCELLED", "BACKEND_UNAVAILABLE", "INTERNAL_ERROR"]
    },
    {
      "address": "storage.get",
      "visibility": "public",
      "permission": { "id": "storage" },
      "params": { "type": "object", "additionalProperties": false, "required": ["scope", "key"], "properties": { "scope": { "enum": ["plugin", "workspace"] }, "key": { "type": "string", "minLength": 1 } } },
      "result": { "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["found", "value"], "properties": { "found": { "const": true }, "value": { "$ref": "#/$defs/jsonValue" } } },
        { "type": "object", "additionalProperties": false, "required": ["found", "value"], "properties": { "found": { "const": false }, "value": { "const": null } } }
      ] },
      "errors": ["CAPABILITY_DENIED", "INVALID_ARGUMENT", "WORKSPACE_SCOPE_VIOLATION", "STORAGE_QUOTA_EXCEEDED", "BACKEND_UNAVAILABLE", "INTERNAL_ERROR"]
    },
    {
      "address": "storage.set",
      "visibility": "public",
      "permission": { "id": "storage" },
      "params": { "type": "object", "additionalProperties": false, "required": ["scope", "key", "value"], "properties": { "scope": { "enum": ["plugin", "workspace"] }, "key": { "type": "string", "minLength": 1 }, "value": { "$ref": "#/$defs/jsonValue" } } },
      "result": { "type": "null" },
      "errors": ["CAPABILITY_DENIED", "INVALID_ARGUMENT", "WORKSPACE_SCOPE_VIOLATION", "STORAGE_QUOTA_EXCEEDED", "BACKEND_UNAVAILABLE", "INTERNAL_ERROR"]
    },
    {
      "address": "storage.delete",
      "visibility": "public",
      "permission": { "id": "storage" },
      "params": { "type": "object", "additionalProperties": false, "required": ["scope", "key"], "properties": { "scope": { "enum": ["plugin", "workspace"] }, "key": { "type": "string", "minLength": 1 } } },
      "result": { "type": "boolean" },
      "errors": ["CAPABILITY_DENIED", "INVALID_ARGUMENT", "WORKSPACE_SCOPE_VIOLATION", "STORAGE_QUOTA_EXCEEDED", "BACKEND_UNAVAILABLE", "INTERNAL_ERROR"]
    }
  ],
  "events": [
    {
      "address": "workspace.filesChanged",
      "visibility": "public",
      "permission": { "id": "system", "access": "fs", "scope": "workspace" },
      "payload": { "type": "object", "additionalProperties": false, "required": ["changes"], "properties": { "changes": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "kind"], "properties": { "path": { "type": "string" }, "kind": { "enum": ["created", "changed", "deleted"] } } } } } }
    },
    {
      "address": "aiCli.output",
      "visibility": "public",
      "permission": { "id": "system", "access": "aiCli", "scope": "workspace" },
      "payload": { "type": "object", "additionalProperties": false, "required": ["sessionId", "data"], "properties": { "sessionId": { "type": "string", "minLength": 1 }, "data": { "type": "string" } } }
    },
    {
      "address": "aiCli.exited",
      "visibility": "public",
      "permission": { "id": "system", "access": "aiCli", "scope": "workspace" },
      "payload": { "type": "object", "additionalProperties": false, "required": ["sessionId", "exitCode"], "properties": { "sessionId": { "type": "string", "minLength": 1 }, "exitCode": { "type": ["integer", "null"] } } }
    }
  ],
  "firstPartyNamespaces": [],
  "legacyExceptions": [
    { "event": "git.changed", "authorizedBy": "legacy fs", "replacement": "workspace.filesChanged" }
  ]
}
