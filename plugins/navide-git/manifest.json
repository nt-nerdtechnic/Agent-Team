{
  "schemaVersion": 2,
  "apiVersion": "^1.0.0",
  "id": "navide.git",
  "name": "Git",
  "version": "0.1.0",
  "publisher": "navide",
  "engines": { "navide": "^0.1.0" },
  "permissions": {
    "system": ["fs", "ui", "aiCli"],
    "shell": "allowlist"
  },
  "marketplace": {
    "icon": "assets/git.png",
    "description": "Browse and manage workspace Git repositories in the left region or a separate window.",
    "license": "MIT",
    "repository": "https://github.com/nt-nerdtechnic/Navide",
    "categories": ["productivity", "version-control"]
  },
  "contributes": {
    "views": [
      {
        "id": "left",
        "kind": "custom",
        "location": "left",
        "title": "Git",
        "icon": "assets/git.png",
        "entry": "frontend/left/index.html"
      },
      {
        "id": "window",
        "kind": "custom",
        "location": "window",
        "title": "Git",
        "icon": "assets/git.png",
        "entry": "frontend/window/index.html"
      }
    ]
  }
}
